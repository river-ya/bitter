/* 相机遮罩 */
.mask-top, .mask-bottom {
  width: 100%;
  background: #000;
  transition: height 0.3s ease;
}

/* 相机比例样式 */
.camera {
  width: 100%;
  background: #000;
  transition: height 0.3s ease;
}

/* 修改预览容器确保图片完整显示 */
.preview-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 滤镜列表样式 */
.filters-list {
  padding: 15rpx;
  white-space: nowrap;
  background: rgba(0,0,0,0.8);
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0 10rpx;
  padding: 12rpx 20rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.filter-item.active {
  background: rgba(255,255,255,0.25);
  transform: scale(1.05);
}

.filter-item.applied {
  border: 1rpx solid rgba(255,255,255,0.5);
}

.filter-name {
  color: #fff;
  font-size: 24rpx;
  font-family: "KaiTi", "STKaiti", "楷体", sans-serif;
}

/* 滤镜调整器样式 */
.filter-adjuster {
  padding: 15rpx;
  background: rgba(0,0,0,0.8);
  margin-bottom: 2rpx;
}

.adjuster-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.intensity-value {
  color: #fff;
  font-size: 24rpx;
  min-width: 60rpx;
  text-align: right;
}

.filter-slider {
  width: 80%;
  margin: 0 auto;
}

.bitter-face-popup {
  padding: 20rpx;
  background: rgba(0,0,0,0.8);
}

.bitter-face-options {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.bitter-face-item {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  overflow: hidden;
}

.bitter-face-item image {
  width: 100%;
  height: 100%;
}

.effect-buttons {
  position: fixed;
  top: 20rpx;
  left: 0;
  right: 0;
  z-index: 100;
}

.button-group {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
  padding: 10rpx;
}

.eachbutton{
    display: flex;
    flex-direction: column;
    font-size: 25rpx;
    color: #fff;
    height: 150rpx;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 5rpx;
}

.effect-btn {
  width: 120rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
}

.effect-btn.active {
  border-color: #007AFF;
}

.effect-preview {
  width: 100%;
  height: 100%;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(0, 0, 0, 0.5);
  gap: 60rpx;
  padding: 0 40rpx;
}

.switch-camera {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  position: absolute;
  left: 10%;
}

.camera-icon {
  width: 50rpx;
  height: 50rpx;
}

.capture-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(130deg ,lightcoral, khaki );
  display: flex;
  align-items: center;
  justify-content: center;
}

.take{
    height: 50rpx;
    width: 50rpx;
    border-radius: 100%;
    background: #fff;
}



/* 修改操作按钮样式 */
.action-btn {
  flex: 1;
  height: 120rpx;
  border-radius: 60rpx;
  border: none;
  padding: 0;
  margin: 0 20rpx;
  background: transparent;

  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.cancel, .save, .edit {
  /* width: 80rpx; */
  /* height: 80rpx; */
  height: 50%;
}

.back-btn {
  background: rgba(255, 255, 255, 0.2);
}

.save-btn {
  background: rgba(0, 122, 255, 1);
}

.edit-btn {
  background: rgba(255, 255, 255, 0.2);
}

.effect-preview-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
} 