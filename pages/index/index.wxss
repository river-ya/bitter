}

/* 主页样式美化 */
.home-header {
  padding: 60rpx 40rpx;
  text-align: center;
  background: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent);
}

.home-title {
  font-size: 48rpx;
  color: #fff;
